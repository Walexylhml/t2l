# ---------------------------------------------------------------------------
# Thoughts2Lyfe - Environment variables
# Copy this file to ".env.local" and fill in the real values.
# NEVER commit ".env.local" (it is gitignored). See SETUP.md for where each
# value comes from.
# ---------------------------------------------------------------------------

# Public base URL of the site (no trailing slash).
# Local dev: http://localhost:3000 | Production: https://thoughts2lyfe.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project Settings -> API. The URL and anon key are safe for the browser.
# The service role key is SECRET and must only be used server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---------------------------------------------------------------
# Developers -> API keys (use TEST keys while developing).
# Publishable key is safe for the browser; secret key is server-side only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) ----------------------------------------
# API Keys -> Create API Key. Leave blank to disable emails (no-op).
RESEND_API_KEY=
# Verified sender address, e.g. "Thoughts2Lyfe <orders@yourdomain.com>".
ORDER_FROM_EMAIL=
